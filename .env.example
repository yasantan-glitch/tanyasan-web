# /iletisim formunun gönderim ayarları (app/iletisim/actions.ts).
# Bu değişkenler RUNTIME'da okunur: eksik olmaları build'i kırmaz, yalnızca
# form gönderimi başarısız olur ve kullanıcıya doğrudan e-posta/telefon
# alternatifi gösterilir.
#
# Yerelde: bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Canlıda: Vercel → Project Settings → Environment Variables.

# resend.com → API Keys
RESEND_API_KEY=

# Formun düşeceği kutu. Boş bırakılırsa app/content/contact.ts'teki adres
# kullanılır.
CONTACT_TO=tan@tanyasan.com

# Gönderici. Resend'de DOĞRULANMIŞ bir domainde olmak zorunda (tanyasan.com
# DNS'i Vercel'e taşındıktan sonra oraya Resend'in DKIM/SPF kayıtları eklenir).
CONTACT_FROM="Tan Yasan Web <site@tanyasan.com>"
